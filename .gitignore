*.pyc
*.pyo
*.pyd

# Migration build output
scripts/export-tencent-vdb/dist/
scripts/migrate-sqlite-to-tcvdb/dist/
scripts/read-local-memory/dist/

# Root-level build output (not used at runtime, not published)
/dist/

node_modules/
benchmark-runs/
.codebuddy
.ai_assets

# Dev-only scripts (not shipped in MR)
install-plugin.sh
# package-lock.json WAS ignored here. That single line is why every CI run was
# red from 2026-06-16 to 2026-08-23: the runner checked out a repo with no
# lockfile, so `npm install` re-resolved the whole graph from the registry and
# eventually hit a transitive package whose peer set npm 10 cannot place
# (crash inside arborist `#loadPeerSet`). A lockfile is not a dev-only file:
# it is what makes an install reproducible. It is committed now, and the CI
# uses `npm ci`.
!claude-code-plugin/package-lock.json
pnpm-lock.yaml
yarn.lock
test-offload.sh
test-offload-mmd.sh
test-offload-sessions.sh

# npm pack / release tarballs (never commit packaged outputs)
*.tgz
*.tar.gz

# Local development notes (contributor-only, not shipped) — EXCEPT design specs,
# which are the durable architectural record (the WHY behind the code).
docs/superpowers/*
!docs/superpowers/specs/

# Root CLAUDE.md is the project's own entry sheet on this fork (PR #9 merged the pointer to it
# but the file itself was silently dropped by the old ignore rule). Nested per-developer copies stay ignored.
**/CLAUDE.md
!/CLAUDE.md

# Plugin build output: COMMITTED on purpose so the plugin runs the moment it is
# cloned/installed, with no build step (mirrors the precompiled ARM64 vec0.dll we
# ship). To rebuild from source: npm install && npm run build (in claude-code-plugin/).

# Windows launcher secrets (provider API keys) - NEVER commit, local only
gateway.secrets.env
*.secrets.env

# Local dev artifacts (Sinapsys)
*.log
kb-probe.mts
.claude/
# Local-only live-verification harnesses (real LLM / live vectors.db) + their output
src/**/__tests__/_*.test.ts
*_live_out.txt
*_dryrun_out.txt

# Throwaway analysis/backfill scratch scripts + on-disk audit dumps (never commit;
# audit JSON carries internal fact/entity ids)
scratch-*
*-audit*.json
